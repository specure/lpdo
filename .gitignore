# Rust build artifacts (workspace + every crate)
target/

# Cargo workspace: only the root Cargo.lock is authoritative. Member crates must
# not carry their own lockfiles — Cargo ignores them in a workspace, and
# Dependabot would otherwise "fix" lockfiles the build never reads.
/chess-db/Cargo.lock
/chess-client/src-tauri/Cargo.lock

# Node
node_modules/

# Local Claude Code settings (per-machine, not for the public repo)
.claude/

# Secrets — the .env.example template IS committed; real env files are not
.env
.env.*
!.env.example

# Prebuilt Tauri sidecar binary — rebuilt by `npm run dev:prepare` / setup-dev.sh.
# Keep the folder (.gitkeep) and the helper script, drop the platform binaries.
/chess-client/src-tauri/binaries/chess-db-*

# Local chess data / downloads should never live in the repo
*.duckdb
*.db

# Local dev/debug helper scripts (per-machine, hardcoded paths) — not for the repo
/rebuild.sh
/rebuild-v2.sh
/findline.sh

# OS / editor junk
.DS_Store
*.swp
*~
