{
  "name": "chess-client",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prepare": "cargo build -p chess-db --release --manifest-path ../Cargo.toml && cp ../target/release/chess-db src-tauri/binaries/chess-db-$(rustc -vV | grep host | awk '{print $2}')",
    "dev:all": "npm run dev:prepare && npm run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "chess.js": "^1.4.0",
    "react": "^19.1.0",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
